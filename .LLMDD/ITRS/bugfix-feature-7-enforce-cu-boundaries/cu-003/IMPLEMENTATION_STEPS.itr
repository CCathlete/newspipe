mkdir -p /tmp/opencode/dirtyprobe/tools
cd /tmp/opencode/dirtyprobe
git init -q .
printf 'x = 1\n' > tools/a.py
git add tools/a.py
git -c user.email=a@b -c user.name=c commit -qm init
python3 - <<'PY'
import sys
from pathlib import Path
sys.path.insert(0, "/home/kcat/Repos/llm-driven-design/.LLMDD/tools")
import run_waves as rw
root = Path("/tmp/opencode/dirtyprobe")
assert rw._dirty_paths(root) == frozenset()
PY
printf 'x = 2\n' >> tools/a.py
python3 - <<'PY'
import sys
from pathlib import Path
sys.path.insert(0, "/home/kcat/Repos/llm-driven-design/.LLMDD/tools")
import run_waves as rw
root = Path("/tmp/opencode/dirtyprobe")
