cd /home/kcat/Repos/llm-driven-design
PYTHONPATH=.LLMDD/tools python3 - <<'PY'
from cu_scope import has_enforceable_patterns, is_touched, parse_no_touch, resolve_patterns, write_paths
base = '.LLMDD/ITRS/bugfix-feature-5-enforce-advisor-read-only-approval'
for cu in ('cu-001','cu-002','cu-003','cu-004'):
    p = parse_no_touch(open(base+'/'+cu+'/IMPLEMENTATION_STEPS.itr').read())
    assert not p.unparsed and has_enforceable_patterns(p)
sm=parse_no_touch('Do NOT touch: .LLMDD/tools/a.py; .LLMDD/tools/b.py\nStop when green.\n')
assert len(sm.patterns)==2
wr=parse_no_touch('Do NOT touch: .opencode/agents/v.md,\n        any Python tool.\nStop when green.\n')
assert '.LLMDD/tools/*.py' in wr.patterns
assert is_touched(wr.patterns, '.LLMDD/tools/x.py') and not is_touched(wr.patterns, '.LLMDD/tools/sub/x.py')
assert parse_no_touch('Do NOT touch: .LLMDD/agents\nStop when green.\n').patterns==('.LLMDD/agents/**',)
assert parse_no_touch('Do NOT touch: the sys-prompt tensor, any Scala source\nStop when green.\n').unparsed==('the sys-prompt tensor',)
r=resolve_patterns(parse_no_touch('Do NOT touch: .opencode/agents/llmdd/coder.md\nStop when green.\n').patterns, __import__('pathlib').Path('.'))
assert '.LLMDD/agents/coder.md' in r
print('ok')
PY
