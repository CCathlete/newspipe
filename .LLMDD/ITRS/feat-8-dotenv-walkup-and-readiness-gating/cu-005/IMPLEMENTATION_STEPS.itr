# IMPLEMENTATION_STEPS: cu-005

1. Change `pipelines/ingestion/src/main/scala/newspipe/infrastructure/env/Env.scala` so the no-argument load resolves through ConfLoader and returns Either, while the explicit-configuration overload keeps its signature for callers that supply a Config. The Either surfaces a missing conf directory or file as a startup failure with a readable message.

```scala
package newspipe.infrastructure.env

import com.typesafe.config.Config
import newspipe.infrastructure.conf.ConfLoader

import java.nio.file.Paths
import scala.jdk.CollectionConverters.*

final case class EnvConfig(
    feeds: List[String],
    pollIntervalSeconds: Long,
    kafkaBootstrap: String,
    rawTopic: String,
    bronzePath: String,
    sparkMaster: String,
    s3Endpoint: String,
    s3PathStyle: Boolean,
    s3AccessKey: String,
    s3SecretKey: String,
    s3Bucket: String
)

object Env:
  private val PipelineFile = "ingestion.conf"

  def load(): Either[String, EnvConfig] =
    for
      loaded <- ConfLoader.load(PipelineFile, Paths.get("").toAbsolutePath)
      dot <- DotEnv.discover(Paths.get("").toAbsolutePath)
    yield load(loaded.config.getConfig("newspipe"), dot)

  def load(cfg: Config): EnvConfig =
    load(cfg, DotEnv.discover(Paths.get("").toAbsolutePath))

  def load(cfg: Config, dot: DotEnv): EnvConfig =
    def pick(key: String, fallback: => String): String =
      sys.env.get(key).orElse(dot.get(key)).getOrElse(fallback)
    def pickLong(key: String, fallback: => Long): Long =
      sys.env.get(key).map(_.toLong).orElse(dot.get(key).map(_.toLong)).getOrElse(fallback)
    def pickBool(key: String, fallback: => Boolean): Boolean =
      sys.env.get(key).map(_.toBoolean).orElse(dot.get(key).map(_.toBoolean)).getOrElse(fallback)

    EnvConfig(
      feeds = pick("NEWSPIPE_FEEDS", cfg.getStringList("feeds").asScala.mkString(","))
        .split(",").toList.map(_.trim).filter(_.nonEmpty),
      pollIntervalSeconds = pickLong("NEWSPIPE_POLL_INTERVAL_SECONDS", cfg.getLong("poll-interval-seconds")),
      kafkaBootstrap = pick("NEWSPIPE_KAFKA_BOOTSTRAP", cfg.getString("kafka.bootstrap-servers")),
      rawTopic = pick("NEWSPIPE_RAW_TOPIC", cfg.getString("kafka.raw-topic")),
      bronzePath = pick("NEWSPIPE_BRONZE_PATH", cfg.getString("bronze.path")),
      sparkMaster = pick("NEWSPIPE_SPARK_MASTER", cfg.getString("spark.master")),
      s3Endpoint = pick("NEWSPIPE_S3_ENDPOINT", cfg.getString("s3.endpoint")),
      s3PathStyle = pickBool("NEWSPIPE_S3_PATH_STYLE", cfg.getBoolean("s3.path-style-access")),
      s3AccessKey = pick("NEWSPIPE_S3_ACCESS_KEY", cfg.getString("s3.access-key")),
      s3SecretKey = pick("NEWSPIPE_S3_SECRET_KEY", cfg.getString("s3.secret-key")),
      s3Bucket = pick("NEWSPIPE_BRONZE_BUCKET", cfg.getString("s3.bucket"))
    )

```

   Prove: `grep -q 'ConfLoader.load' pipelines/ingestion/src/main/scala/newspipe/infrastructure/env/Env.scala && ! grep -q 'ConfigFactory.load' pipelines/ingestion/src/main/scala/newspipe/infrastructure/env/Env.scala && cd pipelines/ingestion && sbt compile`

2. Change `pipelines/ingestion/src/test/scala/newspipe/EnvPrecedenceSpec.scala` so the fallback tier is a temporary conf directory rather than an inline ConfigFactory string. The specification must prove the conf file is actually read, not merely that a Config object behaves.

```scala
package newspipe

import com.typesafe.config.ConfigFactory
import newspipe.infrastructure.env.{DotEnv, Env}
import org.scalatest.funspec.AnyFunSpec
import org.scalatest.matchers.should.Matchers

import java.nio.charset.StandardCharsets
import java.nio.file.{Files, Path}

class EnvPrecedenceSpec extends AnyFunSpec with Matchers:
  private val confDir: Path = Files.createTempDirectory("env-conf").resolve("conf")
  Files.createDirectories(confDir)
  Files.writeString(
    confDir.resolve("ingestion.conf"),
    """
      newspipe {
        feeds = ["http://conf/only"]
        poll-interval-seconds = 300
        kafka { bootstrap-servers = "localhost:9092", raw-topic = "raw_rss" }
        bronze { path = "s3a://lakehouse/bronze/news" }
        spark { master = "local[*]" }
        s3 {
          endpoint = "http://conf:9000"
          path-style-access = true
          access-key = "confkey"
          secret-key = "confsecret"
          bucket = "confbucket"
        }
      }
    """.stripMargin, StandardCharsets.UTF_8)
  private val cfg = ConfigFactory.parseFile(confDir.resolve("ingestion.conf").toFile).resolve().getConfig("newspipe")

  describe("ARCH.DOTENV.MERGE") {
    it("falls back to the conf file when no .env key is present") {
      val env = Env.load(cfg, DotEnv(Map.empty, None))
      env.s3Endpoint shouldBe "http://conf:9000"
      env.feeds shouldBe List("http://conf/only")
    }
    it("prefers a .env value over the conf file") {
      Env.load(cfg, DotEnv(Map("NEWSPIPE_S3_ENDPOINT" -> "http://dotenv:9000"), None)).s3Endpoint shouldBe "http://dotenv:9000"
    }
    it("reads the boolean and integer tiers through the same precedence") {
      val env = Env.load(cfg, DotEnv(Map("NEWSPIPE_S3_PATH_STYLE" -> "false", "NEWSPIPE_POLL_INTERVAL_SECONDS" -> "42"), None))
      env.s3PathStyle shouldBe false
      env.pollIntervalSeconds shouldBe 42
    }
    it("keeps an expanded .env value intact") {
      val raw = Map("NEWSPIPE_S3_ENDPOINT" -> "http://${NEWSPIPE_S3_HOST}:9000", "NEWSPIPE_S3_HOST" -> "rustfs")
      Env.load(cfg, DotEnv.expand(raw).toOption.get, None).s3Endpoint shouldBe "http://rustfs:9000"
    }
    it("carries the object-store fields through to EnvConfig") {
      val env = Env.load(cfg, DotEnv.empty)
      env.s3Bucket shouldBe "confbucket"
      env.s3AccessKey shouldBe "confkey"
      env.s3SecretKey shouldBe "confsecret"
    }
  }
```

   Prove: `cd pipelines/ingestion && sbt "testOnly newspipe.EnvPrecedenceSpec"`

