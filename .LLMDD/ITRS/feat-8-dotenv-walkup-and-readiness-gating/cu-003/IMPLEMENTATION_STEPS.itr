# IMPLEMENTATION_STEPS: cu-003

1. Create `pipelines/ingestion/src/main/scala/newspipe/infrastructure/conf/ConfLoader.scala`. It walks up for a `conf` directory, merges the shared feeds file underneath the pipeline file, and returns a named failure rather than an empty configuration when either the directory or the pipeline file is absent. A silent empty config would surface later as a missing-key exception with no indication that the real problem was an undiscovered directory.

```scala
package newspipe.infrastructure.conf

import com.typesafe.config.{Config, ConfigFactory}

import java.nio.file.{Files, Path}
import scala.annotation.tailrec
import scala.util.Try

final case class LoadedConf(config: Config, directory: Path)

object ConfLoader:
  private val DirName = "conf"
  private val SharedFile = "feeds.conf"

  def discover(start: Path): Option[Path] =
    @tailrec def walk(dir: Path): Option[Path] =
      if dir == null then None
      else
        val candidate: Path = dir.resolve(DirName)
        if Files.isDirectory(candidate) then Some(candidate)
        else walk(dir.getParent)
    walk(start.toAbsolutePath.normalize())

  def load(pipelineFile: String, start: Path): Either[String, LoadedConf] =
    discover(start) match
      case None => Left(s"no '$DirName' directory found at or above $start")
      case Some(dir) =>
        val shared: Path = dir.resolve(SharedFile)
        val own: Path = dir.resolve(pipelineFile)
        if !Files.isRegularFile(own) then Left(s"missing $own")
        else
          val parsedShared: Try[Config] = Try(ConfigFactory.parseFile(shared.toFile))
          val merged: Config =
            parsedShared.fold(_ => ConfigFactory.empty(), c => c.withFallback(ConfigFactory.parseFile(own.toFile)).resolve())
          Right(LoadedConf(merged, dir))
```

   Prove: `grep -q 'def discover' pipelines/ingestion/src/main/scala/newspipe/infrastructure/conf/ConfLoader.scala && cd pipelines/ingestion && sbt compile`

2. Delete `pipelines/ingestion/src/main/resources/application.conf`. ConfigFactory.load resolves against the classpath, so leaving this file in place would keep user configuration inside the artifact and give two competing sources of truth.

```sh
rm pipelines/ingestion/src/main/resources/application.conf
```

   Prove: `test ! -f pipelines/ingestion/src/main/resources/application.conf && echo REMOVED`

3. Create `pipelines/ingestion/src/test/scala/newspipe/ConfLoaderSpec.scala`. Fixtures live under the system temp directory so no test writes into the repository, and no repository conf/ file is read, so the suite does not depend on the machine's configuration.

```scala
package newspipe

import com.typesafe.config.ConfigFactory
import newspipe.infrastructure.conf.ConfLoader
import org.scalatest.funspec.AnyFunSpec
import org.scalatest.matchers.should.Matchers

import java.nio.charset.StandardCharsets
import java.nio.file.{Files, Path}

class ConfLoaderSpec extends AnyFunSpec with Matchers:
  private def chain(depth: Int): Path =
    val root: Path = Files.createTempDirectory("conf-chain")
    (0 until depth).foldLeft(root)((acc, _) => Files.createDirectories(acc.resolve("nested")))
    root

  private def write(dir: Path, name: String, body: String): Unit =
    Files.createDirectories(dir)
    Files.writeString(dir.resolve(name), body, StandardCharsets.UTF_8)

  describe("ConfLoader.discover") {
    it("finds conf/ by walking upward from a nested working directory") {
      val root: Path = chain(3)
      write(root.resolve("conf"), "feeds.conf", "newspipe { feeds = [\"http://a\"] }")
      ConfLoader.discover(root.resolve("nested").resolve("nested")).map(_.getFileName.toString) shouldBe Some("conf")
    }
    it("returns None when no conf/ exists on the path") {
      ConfLoader.discover(Files.createTempDirectory("conf-none")) shouldBe None
    }
  }

  describe("ConfLoader.load") {
    it("reports a named failure when conf/ is absent") {
      val result = ConfLoader.load("ingestion.conf", Files.createTempDirectory("conf-none"))
      result.isLeft shouldBe true
      result.left.map(_.contains("no 'conf' directory")) shouldBe Some(true)
    }
    it("reports a named failure when the pipeline file is missing") {
      val root: Path = chain(1)
      write(root.resolve("conf"), "feeds.conf", "newspipe { feeds = [] }")
      val result = ConfLoader.load("ingestion.conf", root)
      result.isLeft shouldBe true
      result.left.map(_.contains("ingestion.conf")) shouldBe Some(true)
    }
    it("merges the shared file under the pipeline file") {
      val root: Path = chain(1)
      write(root.resolve("conf"), "feeds.conf", "newspipe { feeds = [\"http://shared\"]; poll-interval-seconds = 1 }")
      write(root.resolve("conf"), "ingestion.conf", "newspipe { poll-interval-seconds = 300 }")
      val cfg = ConfLoader.load("ingestion.conf", root).toOption.get.config.getConfig("newspipe")
      cfg.getStringList("feeds").asScala.toList shouldBe List("http://shared")
      cfg.getLong("poll-interval-seconds") shouldBe 300L
    }
  }

```

   Prove: `cd pipelines/ingestion && sbt "testOnly newspipe.ConfLoaderSpec"`

Do NOT touch: `pipelines/enrichment/**` (cu-004), `pipelines/ingestion/src/main/scala/newspipe/infrastructure/env/Env.scala` (cu-005), `conf/**`, `pipelines/ingestion/build.sbt` (cu-007), `.LLMDD/**`.
Stop when the stated Prove command exits 0. On failure, record the failing case and the observed value in per-CU feedback rather than weakening an assertion.
