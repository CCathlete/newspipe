3. Create `pipelines/ingestion/src/test/scala/newspipe/EnvPrecedenceSpec.scala` proving the three tiers resolve in order. The DotEnv tier is exercised by constructing a DotEnv directly, because a filesystem fixture cannot safely mutate `sys.env` from a test JVM.

```scala
package newspipe

import com.typesafe.config.ConfigFactory
import newspipe.infrastructure.env.{DotEnv, Env}
import org.scalatest.funspec.AnyFunSpec
import org.scalatest.matchers.should.Matchers

class EnvPrecedenceSpec extends AnyFunSpec with Matchers:
  private val cfg = ConfigFactory.parseString("""
    newspipe {
      feeds = ["http://conf/only"]
      poll-interval-seconds = 300
      kafka { bootstrap-servers = "localhost:9092", raw-topic = "raw_rss" }
      bronze { path = "s3a://lakehouse/bronze/news" }
      spark { master = "local[*]" }
      s3 {
        endpoint = "http://conf:9000"
        path-style-access = true
        access-key = "confkey"
        secret-key = "confsecret"
        bucket = "confbucket"
      }
    }
  """).getConfig("newspipe")

  describe("ARCH.DOTENV.MERGE") {
    it("falls back to application.conf when no .env key is present") {
      val dot = DotEnv(Map.empty, None)
      Env.load(cfg, dot).s3Endpoint shouldBe "http://conf:9000"
      Env.load(cfg, dot).feeds shouldBe List("http://conf/only")
    }
    it("prefers a .env value over application.conf") {
      val dot = DotEnv(Map("NEWSPIPE_S3_ENDPOINT" -> "http://dotenv:9000"), None)
      Env.load(cfg, dot).s3Endpoint shouldBe "http://dotenv:9000"
    }
    it("reads the boolean and integer tiers through the same precedence") {
      val dot = DotEnv(Map("NEWSPIPE_S3_PATH_STYLE" -> "false", "NEWSPIPE_POLL_INTERVAL_SECONDS" -> "42"), None)
      val env = Env.load(cfg, dot)
      env.s3PathStyle shouldBe false
      env.pollIntervalSeconds shouldBe 42
    }
    it("keeps an expanded .env value intact") {
      val raw = Map("NEWSPIPE_S3_ENDPOINT" -> "http://${NEWSPIPE_S3_HOST}:9000", "NEWSPIPE_S3_HOST" -> "rustfs")
      Env.load(cfg, DotEnv.expand(raw).toOption.get, None).s3Endpoint shouldBe "http://rustfs:9000"
    }
    it("carries the object-store fields through to EnvConfig") {
      val env = Env.load(cfg, DotEnv.empty)
      env.s3Bucket shouldBe "confbucket"
      env.s3AccessKey shouldBe "confkey"
    }
  }
```

   Prove: `cd pipelines/ingestion && sbt "testOnly newspipe.EnvPrecedenceSpec"`

