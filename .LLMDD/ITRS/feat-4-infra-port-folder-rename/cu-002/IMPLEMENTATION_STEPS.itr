3. Rewrite src/main/scala/newspipe/control/dependencyInjection/AppContainer.scala with exactly the content in the scala fence below (only the OpenCodeCliClient import differs from the cu-001 version).
```scala
package newspipe.control.dependencyInjection

import newspipe.application.services.IngestionService
import newspipe.infrastructure.bronze.DeltaBronzeSink
import newspipe.infrastructure.env.EnvConfig
import newspipe.infrastructure.llmdataenricher.OpenCodeCliClient
import newspipe.infrastructure.messagequeue.KafkaRawPublisher
import newspipe.infrastructure.rss.RomeRssClient
import org.apache.spark.sql.SparkSession

import java.util.concurrent.TimeUnit
import scala.concurrent.duration.FiniteDuration

final class AppContainer(env: EnvConfig):
  val spark: SparkSession = SparkSession.builder()
    .appName("newspipe")
    .master(env.sparkMaster)
    .config("spark.sql.extensions", "io.delta.sql.DeltaSparkSessionExtension")
    .config("spark.sql.catalog.spark_catalog", "org.apache.spark.sql.delta.catalog.DeltaCatalog")
    .getOrCreate()
  val rss = new RomeRssClient(env.feeds)
  val enrich = new OpenCodeCliClient(env.opencodeModel, FiniteDuration(env.opencodeTimeoutSeconds, TimeUnit.SECONDS))
  val sink = new DeltaBronzeSink(spark, env.bronzePath)
  val raw = new KafkaRawPublisher(env.kafkaBootstrap, env.rawTopic)
  val service = new IngestionService(rss, enrich, sink, raw)

  def close(): Unit =
    raw.close()
    spark.stop()
```
Prove: `grep -n 'llmdataenricher' src/main/scala/newspipe/control/dependencyInjection/AppContainer.scala` prints the import line.
4. Rewrite src/test/scala/newspipe/OpenCodeParserSpec.scala with exactly the content in the scala fence below (only the OpenCodeCliClient import differs from the current file).
```scala
package newspipe

import newspipe.domain.valueObjects.{GeoArea, Urgency}
import newspipe.infrastructure.llmdataenricher.OpenCodeCliClient
import org.scalatest.funspec.AnyFunSpec
import org.scalatest.matchers.should.Matchers

class OpenCodeParserSpec extends AnyFunSpec with Matchers:
  private val events =
    """{"type":"step_start","part":{"type":"step-start"}}
       |{"type":"text","part":{"type":"text","text":"{\"summary\":\"Strait drills.\",\"countries\":[\"Iran\"],\"geoArea\":\"Middle East\",\"topics\":[\"energy\"],\"actors\":[],\"urgency\":\"high\",\"language\":\"en\"}"}}
       |{"type":"step_finish","part":{"type":"step-finish","reason":"stop"}}""".stripMargin
  describe("OpenCodeCliClient.parseEvents") {
    it("concats text parts and parses summary/countries/geoArea/tags") {
      val e = OpenCodeCliClient.parseEvents(events)
      e.summary shouldBe "Strait drills."
      e.countries shouldBe List("Iran")
      e.geoArea.value shouldBe "Middle East"
      e.topics shouldBe List("energy")
      e.urgency.value shouldBe "high"
    }
    it("defaults missing keys") {
      val e = OpenCodeCliClient.parseEnrichment("{\"summary\":\"x\"}")
      e.countries shouldBe Nil
      e.geoArea.value shouldBe "unknown"
      e.urgency.value shouldBe "low"
      e.language shouldBe "en"
    }
  }
```
Prove: `grep -n 'llmdataenricher' src/test/scala/newspipe/OpenCodeParserSpec.scala` prints the import line.
