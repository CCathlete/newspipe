# IMPLEMENTATION_STEPS: cu-010

1. In `pipelines/ingestion/src/test/scala/newspipe/SourceScanServiceSpec.scala`, create this file. It uses in-memory fakes to prove status counts, failure isolation and that an unchanged re-run skips re-probing.



```scala

package newspipe



import newspipe.application.ports.FeedProbe

import newspipe.application.ports.FeedValidator

import newspipe.application.ports.SourceManifestReader

import newspipe.application.ports.ValidationResultStore

import newspipe.application.services.ScanReport

import newspipe.application.services.SourceScanService

import newspipe.domain.models.ProbeResponse

import newspipe.domain.models.SourceCandidate

import newspipe.domain.models.SourceValidationModels.given

import newspipe.domain.models.ValidationSnapshot

import newspipe.infrastructure.source.RomeFeedValidator

import org.scalatest.funsuite.AnyFunSuite



import java.util.concurrent.atomic.AtomicInteger



final class SourceScanServiceSpec extends AnyFunSuite:

  private val rss: String = "<?xml version=\"1.0\"?><rss version=\"2.0\"><channel><title>T</title><link>http://f</link><description>D</description><item><title>I</title><link>http://f/1</link><guid>http://f/1</guid><description>Body</description><pubDate>Tue, 26 Nov 2024 10:00:00 GMT</pubDate></item></channel></rss>"



  private final class MemoryReader(candidates: List[SourceCandidate]) extends SourceManifestReader:

    def read(path: String): Either[String, List[SourceCandidate]] = Right(candidates)



  private final class MemoryStore(var snapshot: Option[ValidationSnapshot]) extends ValidationResultStore:

    def load(): Either[String, Option[ValidationSnapshot]] = Right(snapshot)

    def save(value: ValidationSnapshot): Either[String, Unit] =

      snapshot = Some(value)

      Right(())



  private final class CountingProbe extends FeedProbe:

    val calls: AtomicInteger = new AtomicInteger(0)

    def probe(url: String): Either[String, ProbeResponse] =

      calls.incrementAndGet()

      if url.contains("broken") then Left("connection refused: " + url)

      else if url.contains("missing") then Right(ProbeResponse(404, url, "text/html", ""))

      else Right(ProbeResponse(200, url, "application/rss+xml", rss))



  test("one broken endpoint does not stop the batch and statuses are counted") {

    val candidates: List[SourceCandidate] = List(

      SourceCandidate("good", None, None, List("http://f/good")),

      SourceCandidate("down", None, None, List("http://f/broken")),

      SourceCandidate("dead", None, None, List("http://f/missing"))

    )

    val store: MemoryStore = new MemoryStore(None)

    val service: SourceScanService = new SourceScanService(new MemoryReader(candidates),

      new CountingProbe, new RomeFeedValidator, store, "unused.json", 2, false)

    val result: Either[String, ScanReport] = service.runOnce()

    assert(result.isRight)

    val report: ScanReport = result.toOption.get

    assert(report.candidates == 3)

    assert(report.usable == 1)

    assert(report.unavailable == 1)

    assert(report.invalid == 1)

    assert(report.usableUrls == List("http://f/good"))

    service.close()

  }



  test("an unchanged re-run reuses a usable result without re-probing") {

    val candidates: List[SourceCandidate] = List(SourceCandidate("good", None, None, List("http://f/good")))

    val probe: CountingProbe = new CountingProbe

    val store: MemoryStore = new MemoryStore(None)

    val service: SourceScanService = new SourceScanService(new MemoryReader(candidates),

      probe, new RomeFeedValidator, store, "unused.json", 2, false)

    assert(service.runOnce().isRight)

    assert(probe.calls.get() == 1)

    assert(service.runOnce().toOption.get.usable == 1)

    assert(probe.calls.get() == 1)

    service.close()

  }

```



Prove: `cd pipelines/ingestion && sbt "testOnly newspipe.SourceScanServiceSpec"` prints `[info] All tests passed`.



Do NOT touch: pipelines/ingestion/src/main/**, conf/**, scripts/**, pipelines/enrichment/**



Stop when SourceScanServiceSpec is green; the scale test is next.



2. In `pipelines/ingestion/src/test/scala/newspipe/SourceValidationScaleSpec.scala`, create this file. It feeds 1000 candidates through the real service with a fixed probe and asserts bounded concurrency and full accounting.



```scala

package newspipe



import newspipe.application.ports.FeedProbe

import newspipe.application.ports.FeedValidator

import newspipe.application.ports.SourceManifestReader

import newspipe.application.ports.ValidationResultStore

import newspipe.application.services.ScanReport

import newspipe.application.services.SourceScanService

import newspipe.domain.models.ProbeResponse

import newspipe.domain.models.SourceCandidate

import newspipe.domain.models.SourceValidationModels.given

import newspipe.domain.models.ValidationSnapshot

import newspipe.infrastructure.source.RomeFeedValidator

import org.scalatest.funsuite.AnyFunSuite



import java.util.concurrent.atomic.AtomicInteger



final class SourceValidationScaleSpec extends AnyFunSuite:

  private val rss: String = "<?xml version=\"1.0\"?><rss version=\"2.0\"><channel><title>T</title><link>http://f</link><description>D</description><item><title>I</title><link>http://f/1</link><guid>http://f/1</guid><description>Body</description><pubDate>Tue, 26 Nov 2024 10:00:00 GMT</pubDate></item></channel></rss>"



  private final class ThousandReader extends SourceManifestReader:

    def read(path: String): Either[String, List[SourceCandidate]] =

      Right((1 to 1000).map(i => SourceCandidate("pub-" + i, None, None, List("http://f/" + i))).toList)



  private final class MemoryStore extends ValidationResultStore:

    private var snapshot: Option[ValidationSnapshot] = None

    def load(): Either[String, Option[ValidationSnapshot]] = Right(snapshot)

    def save(value: ValidationSnapshot): Either[String, Unit] =

      snapshot = Some(value)

      Right(())



  private final class BoundedProbe extends FeedProbe:

    val calls: AtomicInteger = new AtomicInteger(0)

    val active: AtomicInteger = new AtomicInteger(0)

    val peak: AtomicInteger = new AtomicInteger(0)

    def probe(url: String): Either[String, ProbeResponse] =

      calls.incrementAndGet()

      val running: Int = active.incrementAndGet()

      peak.accumulateAndGet(running, (a: Int, b: Int) => math.max(a, b))

      Thread.sleep(2L)

      active.decrementAndGet()

      Right(ProbeResponse(200, url, "application/rss+xml", rss))



  test("one thousand candidates are all accounted for with at most eight concurrent probes") {

    val probe: BoundedProbe = new BoundedProbe

    val service: SourceScanService = new SourceScanService(new ThousandReader,

      probe, new RomeFeedValidator, new MemoryStore, "unused.json", 8, false)

    val result: Either[String, ScanReport] = service.runOnce()

    assert(result.isRight)

    val report: ScanReport = result.toOption.get

    assert(report.candidates == 1000)

    assert(report.usable == 1000)

    assert(report.usableUrls.size == 1000)

    assert(probe.calls.get() == 1000)

    assert(probe.peak.get() <= 8)

    service.close()

  }

```



Prove: `cd pipelines/ingestion && sbt "testOnly newspipe.SourceValidationScaleSpec"` prints `[info] All tests passed`.



Do NOT touch: pipelines/ingestion/src/main/**, conf/**, scripts/**, pipelines/enrichment/**



Stop when SourceValidationScaleSpec is green; the collection-path integration test is next.



3. In `pipelines/ingestion/src/test/scala/newspipe/SourceValidationIntegrationSpec.scala`, create this file. It proves that the usable URLs from a scan are the only URLs a ValidatedRssSource fetches, using a loopback RSS server.



```scala

package newspipe



import com.sun.net.httpserver.HttpServer

import newspipe.application.ports.FeedProbe

import newspipe.application.ports.FeedValidator

import newspipe.application.ports.SourceManifestReader

import newspipe.application.ports.ValidationResultStore

import newspipe.application.services.SourceScanService

import newspipe.domain.models.ProbeResponse

import newspipe.domain.models.SourceCandidate

import newspipe.domain.models.SourceValidationModels.given

import newspipe.domain.models.ValidationSnapshot

import newspipe.infrastructure.rss.ValidatedRssSource

import newspipe.infrastructure.source.RomeFeedValidator

import org.scalatest.funsuite.AnyFunSuite



import java.net.InetSocketAddress

import java.nio.charset.StandardCharsets

import java.time.Duration



final class SourceValidationIntegrationSpec extends AnyFunSuite:

  private val rss: String = "<?xml version=\"1.0\"?><rss version=\"2.0\"><channel><title>T</title><link>http://f</link><description>D</description><item><title>I</title><link>http://f/1</link><guid>http://f/1</guid><description>Body</description><pubDate>Tue, 26 Nov 2024 10:00:00 GMT</pubDate></item></channel></rss>"



  private final class SingleReader(url: String) extends SourceManifestReader:

    def read(path: String): Either[String, List[SourceCandidate]] =

      Right(List(SourceCandidate("pub", None, None, List(url))))



  private final class DirectProbe extends FeedProbe:

    def probe(url: String): Either[String, ProbeResponse] =

      Right(ProbeResponse(200, url, "application/rss+xml", rss))



  private final class MemoryStore extends ValidationResultStore:

    private var snapshot: Option[ValidationSnapshot] = None

    def load(): Either[String, Option[ValidationSnapshot]] = Right(snapshot)

    def save(value: ValidationSnapshot): Either[String, Unit] =

      snapshot = Some(value)

      Right(())



  test("scan result flows into the collection adapter and yields one item") {

    val server: HttpServer = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0)

    server.createContext("/rss", exchange => {

      val bytes: Array[Byte] = rss.getBytes(StandardCharsets.UTF_8)

      exchange.getResponseHeaders.add("Content-Type", "application/rss+xml")

      exchange.sendResponseHeaders(200, bytes.length.toLong)

      exchange.getResponseBody.write(bytes)

      exchange.close()

    })

    server.start()

    val url: String = "http://127.0.0.1:" + server.getAddress.getPort + "/rss"

    val service: SourceScanService = new SourceScanService(new SingleReader(url),

      new DirectProbe, new RomeFeedValidator, new MemoryStore, "unused.json", 1, false)

    val report = service.runOnce()

    assert(report.isRight)

    val usableUrls: List[String] = report.toOption.get.usableUrls

    assert(usableUrls == List(url))

    val source: ValidatedRssSource = new ValidatedRssSource(usableUrls, Duration.ofSeconds(2))

    assert(source.fetch().size == 1)

    service.close()

    server.stop(0)

  }

```



Prove: `cd pipelines/ingestion && sbt "testOnly newspipe.SourceValidationIntegrationSpec"` prints `[info] All tests passed`.



Do NOT touch: pipelines/ingestion/src/main/**, conf/**, scripts/**, pipelines/enrichment/**



Stop when SourceValidationIntegrationSpec is green; E2E verification is cu-011.
